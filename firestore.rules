rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Common Security Helper Functions
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health / Connection Test probe
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Orders Collection: Accessible for Storefront Checkout, Receipt Lookup & Admin Dashboard
    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(orderId);
    }

    // Customers Collection: Registration Database for Customers
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(customerId);
    }

    // Visitors, Bookings & Booking Steps Collections for real-time tracking
    match /visitors/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(sessionId);
    }

    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(bookingId);
    }

    match /bookings_steps/{stepId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(stepId);
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
